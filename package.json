{
  "name": "exodus-cli",
  "version": "0.1.0",
  "module": "index.ts",
  "type": "module",
  "bin": {
    "exodus": "./index.ts"
  },
  "scripts": {
    "dev": "bun run index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:npm": "bun build ./index.ts --outdir dist --target bun --format esm && chmod +x dist/index.js",
    "build:binaries": "bash scripts/build-binaries.sh"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ink": "7.1.1",
    "react": "19.3.0",
    "ink-text-input": "6.0.0",
    "ink-spinner": "5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3"
  }
}
